{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Endo ASD",
      "type": "shell",
      "command": "python3 serve.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "endo-asd",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local UI:"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Endo ASD",
      "dependsOn": ["Start Endo ASD"],
      "dependsOrder": "sequence",
      "type": "shell",
      "command": "echo Endo ASD is running",
      "problemMatcher": []
    },
    {
      "label": "Start Endo ASD (browser)",
      "type": "shell",
      "command": "ENDO_ASD_BROWSER=1 python3 serve.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "endo-asd-browser",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Local UI:"
        }
      }
    }
  ]
}
