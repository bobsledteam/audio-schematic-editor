{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Guitar Wiring App",
      "type": "shell",
      "command": "python3 serve.py",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "guitar-wiring",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Guitar Wiring App running at"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      }
    },
    {
      "label": "Run Guitar Wiring App",
      "dependsOn": ["Start Guitar Wiring App"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
